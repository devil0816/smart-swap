# Smart Swap Environment Configuration
# ==============================================================================
# To connect to Supabase:
# 1. Sign up / Log in to https://supabase.com
# 2. Open your project -> Click 'Project Settings' (gear icon) -> 'Database'
# 3. Under 'Connection string', select 'URI' -> Mode: 'Session' (port 5432) or 'Transaction' (port 6543)
# 4. Copy the connection string, replace [YOUR-PASSWORD] with your actual database password,
#    and paste it below as DATABASE_URL.
# ==============================================================================

# Supabase PostgreSQL connection string example:
# DATABASE_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Flask Secret Key for sessions and CSRF
SECRET_KEY=smart-swap-dev-secret-key-2026-exchange-platform

# Debug mode (set to False for production)
FLASK_DEBUG=True
